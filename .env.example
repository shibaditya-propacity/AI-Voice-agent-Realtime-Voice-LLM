# ====================================================
# VOICE AI AGENT - Environment Configuration
# ====================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ====================================================

# --- SERVER ---
PORT=8080
NODE_ENV=development

# ── Knowlarity (commented out — replaced by Twilio) ─────────────────────────
# KNOWLARITY_API_KEY=
# KNOWLARITY_API_SECRET=
# KNOWLARITY_SR_NUMBER=
# KNOWLARITY_CALLER_ID=
# KNOWLARITY_API_URL=https://kpi.knowlarity.com
# KNOWLARITY_MEDIA_WS_URL=wss://media.knowlarity.com
# KNOWLARITY_WEBHOOK_URL=https://your-server.example.com/webhooks/knowlarity

# --- TWILIO ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public HTTPS base URL for Twilio webhooks (e.g. https://your-server.example.com)
# Required only for outbound calls. Inbound streams use the Host header automatically.
TWILIO_WEBHOOK_BASE_URL=

# --- KRISP ---
# No API key required — the SDK is activated via local model files.
# Set KRISP_MODEL_PATH to the directory that contains Krisp model files
# (bundled with the SDK package you receive from Krisp).
KRISP_MODEL_PATH=./krisp_models

# Optional: path to a Krisp license file (leave empty if not required by your SDK edition)
KRISP_LICENSE_PATH=

# Frame size in samples (160 = 10ms at 16kHz, 320 = 20ms at 16kHz)
KRISP_FRAME_SIZE_SAMPLES=160

# --- AWS / AMAZON NOVA SONIC ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Nova Sonic model ID in Amazon Bedrock
# Nova 2 (current): amazon.nova-2-sonic-v1:0  |  Nova 1 (old): amazon.nova-sonic-v1:0
NOVA_MODEL_ID=amazon.nova-2-sonic-v1:0

# NOTE: The system prompt is NOT configured here.
# Edit the systemPrompt field in src/config/env.ts directly.

# Maximum tokens per Nova Sonic response turn
NOVA_MAX_TOKENS=512

# Nova Sonic temperature (0.0 - 1.0)
NOVA_TEMPERATURE=0.7

# Nova Sonic top-p
NOVA_TOP_P=0.9

# Nova Sonic audio output voice
# arjun = Indian English + Hindi code-switching (Nova 2 only)
# tiffany = US English female | matthew = US English male | amy = British English
NOVA_VOICE_ID=arjun

# Nova 2 VAD endpointing sensitivity (HIGH | MEDIUM | LOW)
# Controls how quickly Nova decides the caller has finished speaking:
#   HIGH   = responds fastest, but cuts callers off at natural pauses → only
#            captures PART of the sentence (dropped words, choppy turns, name loops).
#   MEDIUM = waits longer for the caller to actually finish → full utterances,
#            cleaner turns; slightly higher response latency. (Recommended.)
#   LOW    = waits longest; most patient, highest latency.
# Omit entirely for Nova 1 (it rejects this field).
NOVA_ENDPOINTING_SENSITIVITY=MEDIUM

# How the conversation is primed on connect: none | cue | assistant
#   none (default) — send NO cue. Nova stays silent after the greeting and the
#     caller's spoken name becomes the first real (audio-driven) turn, so the name is
#     transcribed instead of Nova answering a cue with a "[caller's name]" placeholder
#     and talking over the caller. Same VAD path that later turns already use.
#   cue — a USER text turn that makes Nova respond immediately. Use ONLY if 'none'
#     leaves Nova silent after the greeting (VAD doesn't drive the first turn).
#   assistant — DO NOT USE: Nova rejects an injected ASSISTANT turn → dropped call.
NOVA_FIRST_TURN_MODE=none

# First-turn speech gate (ms). After the greeting, caller audio is held OUT of Nova
# until the caller actually starts speaking, so Nova can't endpoint on the
# post-greeting silence and talk over the caller's name. This many ms with no speech
# force-opens the gate (so a silent caller still gets re-engaged). 0 disables it.
NOVA_FIRST_TURN_SPEECH_GATE_MS=1500

# Exact words the greeting WAV (assets/greeting.wav) speaks. Used by assistant mode.
NOVA_GREETING_TEXT=Hi, I am Arjun calling from Akshay Vista. May I know your name please?

# 'cue' mode: the USER text turn whose contentEnd makes Nova respond.
# A bracketed directive telling Nova not to re-greet/re-ask. Leave unset for default.
# NOVA_FIRST_TURN_CUE=[The call just connected. Your opening line "Hi, I am Arjun calling from Akshay Vista. May I know your name please?" has already been played to the caller — the greeting AND the name request are done. Do NOT greet again and do NOT ask for the name again. Wait for the caller to give their name, then respond to it naturally with a brief acknowledgement and continue.]

# When a final caller transcript is captured while INTERRUPTED (barge-in), promote it
# into a new USER turn so Nova answers the caller's actual words. true=on.
NOVA_PROMOTE_INTERRUPTED_TRANSCRIPT=true
# Promotion delay (ms). 0 = fire immediately (synchronous, no timer). Any positive
# value defers promotion by that many ms so Nova can handle the barge-in natively
# (control token or fresh completionStart) — if it does, promotion is cancelled.
# Default 0: proactive barge-in never triggers a native Nova response, so deferring
# only adds latency. Set >0 only if you observe double-responses after barge-in.
NOVA_PROMOTE_INTERRUPTED_DELAY_MS=0

# --- AUDIO PIPELINE ---
# Telephony codec from Twilio: pcmu | pcma | pcm16
TELEPHONY_CODEC=pcmu

# Telephony sample rate (Hz) — Twilio Media Streams default
TELEPHONY_SAMPLE_RATE=8000

# Internal processing sample rate for Krisp and Nova INPUT (caller audio)
INTERNAL_SAMPLE_RATE=16000

# Sample rate Nova produces its SPEECH OUTPUT at (Nova Sonic native = 24000).
# The outbound pipeline downsamples this to TELEPHONY_SAMPLE_RATE. Must match what
# Nova actually emits, or playback sounds slow/garbled. Try 16000 if 24000 is wrong.
NOVA_OUTPUT_SAMPLE_RATE=24000

# How often (ms) to re-warm the Bedrock connection so it never idles out between
# calls. AWS idle-closes HTTP/2 after ~5 min; default re-warms every 4 min. Set 0
# to disable periodic re-warming (boot warm only).
NOVA_PREWARM_INTERVAL_MS=240000

# Audio chunk size in milliseconds
AUDIO_CHUNK_MS=20

# Maximum audio buffer size (bytes) before flushing
AUDIO_BUFFER_MAX_BYTES=32768

# Energy-VAD thresholds for latency instrumentation (timestamps caller speech-end so
# the per-turn latency table can measure Nova's endpointing time). int16 RMS level
# and the sustained-silence window (ms) before speech is considered ended.
VAD_RMS_THRESHOLD=700
VAD_SILENCE_HANGOVER_MS=120

# Proactive barge-in confirmation window (ms). The caller's RMS must stay above
# VAD_RMS_THRESHOLD for this long (near-continuous, brief dips up to
# VAD_SILENCE_HANGOVER_MS tolerated) before the agent is interrupted. Filters noise,
# echo, breathing and handset artifacts that don't sustain. A word-bearing Nova
# transcript also confirms instantly, so genuine speech still interrupts fast.
AUDIO_BARGEIN_CONFIRM_MS=400

# Linear gain applied ONLY to audio forwarded to Nova (after Krisp), so quiet callers
# (e.g. a softly-spoken "yes") are loud enough for Nova's ASR to transcribe — instead
# of the agent looping on "I may not have heard you. Are you still there?". Does NOT
# affect barge-in / speech-gate detection (no new false barge-ins). Clamped to int16.
# 1.0 = off. 2.0 = +6dB (good for quiet telephony). Lower it if loud callers distort.
AUDIO_INPUT_GAIN=2.0

# --- SESSION ---
MAX_CONCURRENT_CALLS=100
SESSION_IDLE_TIMEOUT_MS=600000

# --- LOGGING ---
LOG_LEVEL=info
LOG_PRETTY=false

# --- DEEPGRAM STT (Sarvam pipeline) ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=hi
DEEPGRAM_MULTILINGUAL=true
DEEPGRAM_ENDPOINTING_MS=500
DEEPGRAM_UTTERANCE_END_MS=1200
DEEPGRAM_MIN_CONFIDENCE=0.4

# --- SARVAM TTS ---
SARVAM_API_KEY=
SARVAM_MODEL_ID=bulbul:v3
SARVAM_SPEAKER=arjun
SARVAM_TARGET_LANGUAGE=hi-IN
SARVAM_PACE=1.1

# --- GROQ LLM (Sarvam pipeline) ---
# GROQ_API_KEY is already set above if using Groq for entity extraction
LLM_MODEL_ID=llama-3.1-8b-instant
LLM_MAX_TOKENS=150
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_HISTORY_WINDOW=12

# --- BARGE-IN DETECTION ---
BARGEIN_RMS_THRESHOLD=700
BARGEIN_CONFIRM_MS=400
BARGEIN_COOLDOWN_MS=1500
BARGEIN_GRACE_MS=500

# --- HUMANIZATION ---
HUMANIZATION_ENABLED=true
