{
  "name": "voice-ai-agent",
  "version": "1.0.0",
  "description": "Production-grade realtime AI voice agent: Knowlarity → Krisp → Nova Sonic",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node -r dotenv/config src/index.ts",
    "dev:watch": "ts-node-dev --respawn --transpile-only -r dotenv/config src/index.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.test.json"
      }
    },
    "moduleNameMapper": {
      "^../../config$": "<rootDir>/src/__tests__/__mocks__/config.ts",
      "^../../../config$": "<rootDir>/src/__tests__/__mocks__/config.ts"
    },
    "clearMocks": true
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.731.0",
    "@aws-sdk/client-polly": "^3.1061.0",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "twilio": "^6.0.2",
    "uuid": "^10.0.0",
    "winston": "^3.15.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
