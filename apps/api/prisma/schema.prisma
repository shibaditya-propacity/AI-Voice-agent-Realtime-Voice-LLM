generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model CallLog {
  id           String         @id
  leadId       String?
  callSid      String         @unique
  duration     Int            @default(0)
  language     String         @default("en")
  summary      String?
  direction    String         @default("inbound")
  status       String         @default("COMPLETED")
  from         String?
  to           String?
  recordingUrl String?
  createdAt    DateTime       @default(now())
  Lead         Lead?          @relation(fields: [leadId], references: [id])
  Conversation Conversation[]
}

model Conversation {
  id        String           @id
  leadId    String?
  callLogId String?
  role      ConversationRole
  content   String
  language  String           @default("en")
  createdAt DateTime         @default(now())
  Lead      Lead?            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  CallLog   CallLog?         @relation(fields: [callLogId], references: [id], onDelete: SetNull)
}

model Lead {
  id           String         @id
  name         String?
  phone        String         @unique
  email        String?
  city         String?
  area         String?
  budget       String?
  bhk          String?
  propertyType PropertyType?
  loanRequired Boolean        @default(false)
  timeline     String?
  leadScore    Int            @default(0)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  CallLog      CallLog[]
  Conversation Conversation[]
  SiteVisit    SiteVisit[]
}

model Property {
  id              String       @id
  name            String
  city            String
  area            String
  bhk             String
  propertyType    PropertyType
  price           Float
  description     String
  amenities       String[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime
  address         String?
  availableUnits  Int?
  bookingAmount   String?
  configurations  String[]
  developer       String?
  developerUsp    String?
  floors          Int?
  landArea        String?
  launchDate      String?
  nearbyHospitals String[]
  nearbyLandmarks String[]
  nearbyMalls     String[]
  nearbySchools   String[]
  openSpace       String?
  possessionDate  String?
  pricePerSqftMax Int?
  pricePerSqftMin Int?
  projectUsp      String[]
  rentalYield     String?
  reraApproved    Boolean      @default(false)
  totalUnits      Int?
  towers          Int?
  SiteVisit       SiteVisit[]
}

model SiteVisit {
  id         String          @id
  leadId     String
  propertyId String
  visitDate  DateTime
  status     SiteVisitStatus @default(SCHEDULED)
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime
  Lead       Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  Property   Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model User {
  id        String     @id
  name      String
  email     String     @unique
  password  String
  role      Role       @default(MANAGER)
  createdAt DateTime   @default(now())
  updatedAt DateTime
  Campaigns Campaign[]
}

model Contact {
  id               String            @id
  name             String
  phone            String            @unique
  email            String?
  project          String?
  notes            String?
  source           ContactSource     @default(MANUAL)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  CampaignContacts CampaignContact[]
  CallJobs         CallJob[]
}

model Campaign {
  id               String            @id
  name             String
  description      String?
  status           CampaignStatus    @default(DRAFT)
  totalContacts    Int               @default(0)
  dialedCount      Int               @default(0)
  answeredCount    Int               @default(0)
  failedCount      Int               @default(0)
  scheduledAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdById      String
  CreatedBy        User              @relation(fields: [createdById], references: [id])
  CampaignContacts CampaignContact[]
  CallJobs         CallJob[]
}

model CampaignContact {
  id         String                @id
  campaignId String
  contactId  String
  position   Int                   @default(0)
  status     CampaignContactStatus @default(PENDING)
  createdAt  DateTime              @default(now())
  Campaign   Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  Contact    Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
}

model CallJob {
  id         String        @id
  contactId  String
  campaignId String?
  callSid    String?       @unique
  status     CallJobStatus @default(QUEUED)
  provider   String        @default("voice_server")
  error      String?
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  Contact    Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  Campaign   Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([status, createdAt])
}

enum ConversationRole {
  USER
  ASSISTANT
  SYSTEM
}

enum PropertyType {
  APARTMENT
  VILLA
  COMMERCIAL
  PLOT
}

enum Role {
  ADMIN
  MANAGER
}

enum SiteVisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ContactSource {
  MANUAL
  CSV_IMPORT
  EXCEL_IMPORT
}

enum CampaignStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignContactStatus {
  PENDING
  DIALING
  ANSWERED
  FAILED
  SKIPPED
}

enum CallJobStatus {
  QUEUED
  DIALING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}
