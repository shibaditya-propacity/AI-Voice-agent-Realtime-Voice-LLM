# ====================================================
# VOICE AI AGENT - Environment Configuration
# ====================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ====================================================

# --- SERVER ---
PORT=8080
NODE_ENV=development

# ── Knowlarity (commented out — replaced by Twilio) ─────────────────────────
# KNOWLARITY_API_KEY=
# KNOWLARITY_API_SECRET=
# KNOWLARITY_SR_NUMBER=
# KNOWLARITY_CALLER_ID=
# KNOWLARITY_API_URL=https://kpi.knowlarity.com
# KNOWLARITY_MEDIA_WS_URL=wss://media.knowlarity.com
# KNOWLARITY_WEBHOOK_URL=https://your-server.example.com/webhooks/knowlarity

# --- TWILIO ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public HTTPS base URL for Twilio webhooks (e.g. https://your-server.example.com)
# Required only for outbound calls. Inbound streams use the Host header automatically.
TWILIO_WEBHOOK_BASE_URL=

# --- KRISP ---
# No API key required — the SDK is activated via local model files.
# Set KRISP_MODEL_PATH to the directory that contains Krisp model files
# (bundled with the SDK package you receive from Krisp).
KRISP_MODEL_PATH=./krisp_models

# Optional: path to a Krisp license file (leave empty if not required by your SDK edition)
KRISP_LICENSE_PATH=

# Frame size in samples (160 = 10ms at 16kHz, 320 = 20ms at 16kHz)
KRISP_FRAME_SIZE_SAMPLES=160

# --- AWS / AMAZON NOVA SONIC ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Nova Sonic model ID in Amazon Bedrock
# Nova 2 (current): amazon.nova-2-sonic-v1:0  |  Nova 1 (old): amazon.nova-sonic-v1:0
NOVA_MODEL_ID=amazon.nova-2-sonic-v1:0

# NOTE: The system prompt is NOT configured here.
# Edit the systemPrompt field in src/config/env.ts directly.

# Maximum tokens per Nova Sonic response turn
NOVA_MAX_TOKENS=512

# Nova Sonic temperature (0.0 - 1.0)
NOVA_TEMPERATURE=0.7

# Nova Sonic top-p
NOVA_TOP_P=0.9

# Nova Sonic audio output voice
# arjun = Indian English + Hindi code-switching (Nova 2 only)
# tiffany = US English female | matthew = US English male | amy = British English
NOVA_VOICE_ID=arjun

# Nova 2 VAD endpointing sensitivity (HIGH | MEDIUM | LOW)
# HIGH gives lowest latency on telephony. Omit entirely for Nova 1.
NOVA_ENDPOINTING_SENSITIVITY=HIGH

# Greeting trigger: short USER text cue that makes Nova speak its greeting on
# connect. Nova 2 produces NO output from silence, so we prime with text instead.
# (As if the caller answered and said "Hello?".)
NOVA_GREETING_TRIGGER=Hello?

# --- AUDIO PIPELINE ---
# Telephony codec from Twilio: pcmu | pcma | pcm16
TELEPHONY_CODEC=pcmu

# Telephony sample rate (Hz) — Twilio Media Streams default
TELEPHONY_SAMPLE_RATE=8000

# Internal processing sample rate for Krisp and Nova
INTERNAL_SAMPLE_RATE=16000

# Audio chunk size in milliseconds
AUDIO_CHUNK_MS=20

# Maximum audio buffer size (bytes) before flushing
AUDIO_BUFFER_MAX_BYTES=32768

# --- SESSION ---
MAX_CONCURRENT_CALLS=100
SESSION_IDLE_TIMEOUT_MS=600000

# --- LOGGING ---
LOG_LEVEL=info
LOG_PRETTY=false
