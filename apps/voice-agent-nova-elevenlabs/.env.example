# ============================================================
# VOICE AGENT: Deepgram + Bedrock Claude + ElevenLabs
# Copy to .env and fill in your values.
# ============================================================

# --- SERVER ---
PORT=8081
NODE_ENV=development

# --- TWILIO ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# Public base URL for webhooks (no trailing slash)
TWILIO_WEBHOOK_BASE_URL=https://your-ngrok-or-domain.com

# --- DEEPGRAM ---
DEEPGRAM_API_KEY=your_deepgram_api_key
# Model: nova-3, nova-3-general, nova-2, etc.
DEEPGRAM_MODEL=nova-3
# Language code: en-IN, en-US, hi, etc.
DEEPGRAM_LANGUAGE=en-IN
# Endpointing ms — silence threshold before speech_final fires (100-5000)
DEEPGRAM_ENDPOINTING_MS=300
# Time to wait after last word before UtteranceEnd fires (ms)
DEEPGRAM_UTTERANCE_END_MS=1000

# --- AWS BEDROCK (LLM) ---
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
# Anthropic Bedrock SDK model ID (via @anthropic-ai/bedrock-sdk)
LLM_MODEL_ID=us.anthropic.claude-sonnet-4-6
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
# System prompt for the AI agent
LLM_SYSTEM_PROMPT=You are a helpful real estate assistant for Propacity. Keep responses concise and conversational — 1-3 sentences. You help users with property inquiries, schedules site visits, and answers questions about listings.

# --- ELEVENLABS (TTS) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Voice ID from ElevenLabs dashboard
ELEVENLABS_VOICE_ID=your_voice_id
# Model: eleven_flash_v2_5 (lowest latency), eleven_multilingual_v2, etc.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Stability (0.0 - 1.0) — higher = more consistent, lower = more expressive
ELEVENLABS_STABILITY=0.4
# Similarity boost (0.0 - 1.0)
ELEVENLABS_SIMILARITY_BOOST=0.8
# Speed multiplier (0.7 - 1.2)
ELEVENLABS_SPEED=1.0
# Latency optimization level (0=none, 4=max — trades quality for speed)
ELEVENLABS_OPTIMIZE_LATENCY=4

# --- BARGE-IN ---
# RMS energy threshold on raw PCMU audio (int16 RMS, 0-32768)
BARGEIN_RMS_THRESHOLD=600
# How long (ms) energy must stay above threshold before triggering interrupt
BARGEIN_CONFIRM_MS=150
# Minimum gap between consecutive barge-in events (ms)
BARGEIN_COOLDOWN_MS=300

# --- SESSION ---
MAX_CONCURRENT_CALLS=50
SESSION_IDLE_TIMEOUT_MS=600000

# --- LOGGING ---
LOG_LEVEL=info
LOG_PRETTY=true
