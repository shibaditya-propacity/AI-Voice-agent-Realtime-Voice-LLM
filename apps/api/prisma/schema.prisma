generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model CallLog {
  id           String         @id
  leadId       String?
  callSid      String         @unique
  duration     Int            @default(0)
  language     String         @default("en")
  summary      String?
  direction    String         @default("inbound")
  from         String?
  to           String?
  recordingUrl String?
  createdAt    DateTime       @default(now())
  Lead         Lead?          @relation(fields: [leadId], references: [id])
  Conversation Conversation[]
}

model Conversation {
  id        String           @id
  leadId    String
  callLogId String?
  role      ConversationRole
  content   String
  language  String           @default("en")
  createdAt DateTime         @default(now())
  Lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  CallLog   CallLog?         @relation(fields: [callLogId], references: [id], onDelete: SetNull)
}

model Lead {
  id           String         @id
  name         String?
  phone        String         @unique
  email        String?
  city         String?
  area         String?
  budget       String?
  bhk          String?
  propertyType PropertyType?
  loanRequired Boolean        @default(false)
  timeline     String?
  leadScore    Int            @default(0)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  CallLog      CallLog[]
  Conversation Conversation[]
  SiteVisit    SiteVisit[]
}

model Property {
  id              String       @id
  name            String
  city            String
  area            String
  bhk             String
  propertyType    PropertyType
  price           Float
  description     String
  amenities       String[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime
  address         String?
  availableUnits  Int?
  bookingAmount   String?
  configurations  String[]
  developer       String?
  developerUsp    String?
  floors          Int?
  landArea        String?
  launchDate      String?
  nearbyHospitals String[]
  nearbyLandmarks String[]
  nearbyMalls     String[]
  nearbySchools   String[]
  openSpace       String?
  possessionDate  String?
  pricePerSqftMax Int?
  pricePerSqftMin Int?
  projectUsp      String[]
  rentalYield     String?
  reraApproved    Boolean      @default(false)
  totalUnits      Int?
  towers          Int?
  SiteVisit       SiteVisit[]
}

model SiteVisit {
  id         String          @id
  leadId     String
  propertyId String
  visitDate  DateTime
  status     SiteVisitStatus @default(SCHEDULED)
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime
  Lead       Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  Property   Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id
  name      String
  email     String   @unique
  password  String
  role      Role     @default(MANAGER)
  createdAt DateTime @default(now())
  updatedAt DateTime
}

enum ConversationRole {
  USER
  ASSISTANT
  SYSTEM
}

enum PropertyType {
  APARTMENT
  VILLA
  COMMERCIAL
  PLOT
}

enum Role {
  ADMIN
  MANAGER
}

enum SiteVisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}
